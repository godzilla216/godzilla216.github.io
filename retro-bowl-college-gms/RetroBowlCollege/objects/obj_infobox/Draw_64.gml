draw_self();
draw_set_font(global.fnt_small_flex);
draw_set_halign(1);
var tx = x;
var ty = y;
var sw = 1 + string_hd_width(title) / 2;
var sh = 1 + string_hd_height(title) / 2;
tx += sprite_width / 2;
draw_rectangle_color(tx - sw - 2, ty - sh - 1, tx + sw, ty + sh, global.c_background, global.c_background, global.c_background, global.c_background, 0);
draw_hd_text(tx, ty, string_upper(title));
draw_set_halign(0);
tx = x + 16;
ty = y + 16;
draw_hd_text(tx, ty, string_upper(txt_1));
ty += 16;
draw_hd_text(tx, ty, string_upper(txt_2));
ty += 16;
draw_hd_text(tx, ty, string_upper(txt_3));
ty += 16;
